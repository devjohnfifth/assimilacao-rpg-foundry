<div class="asm-item tipo-{{item.type}} {{#if naipe}}naipe-{{source.system.naipe}}{{/if}}">
  <header class="asm-item-cabecalho">
    <img src="{{item.img}}" data-action="editImage" data-edit="img" alt="">
    <div>
      <span class="asm-etiqueta">{{tipoRotulo}}</span>
      <input class="asm-item-nome" type="text" name="name" value="{{item.name}}">
    </div>
  </header>

  <div class="asm-item-campos">
    {{#if ehCaracteristica}}
      {{formGroup systemFields.custo value=source.system.custo}}
      {{formGroup systemFields.requisitos value=source.system.requisitos}}
    {{/if}}
    {{#if ehEquipamento}}
      {{formGroup systemFields.escassez value=source.system.escassez}}
      {{formGroup systemFields.qualidade value=source.system.qualidade}}
      {{formGroup systemFields.cInvestidas value=source.system.cInvestidas}}
      {{formGroup systemFields.local value=source.system.local localize=true}}
      {{formGroup systemFields.espacos value=source.system.espacos}}
      {{formGroup systemFields.artefato value=source.system.artefato}}
      {{formGroup systemFields.caracteristicas value=source.system.caracteristicas}}
    {{/if}}
    {{#if ehMutacao}}
      {{formGroup systemFields.naipe value=source.system.naipe localize=true}}
      {{formGroup systemFields.carta value=source.system.carta}}
      {{formGroup systemFields.aspecto value=source.system.aspecto}}
      {{formGroup systemFields.custo value=source.system.custo}}
      {{formGroup systemFields.requisitoE value=source.system.requisitoE}}
      {{formGroup systemFields.cPressao value=source.system.cPressao}}
    {{/if}}
    {{#if ehAtivacao}}
      <div class="form-group asm-custo-simbolos">
        <label>{{localize "ASSIMILACAO.Ativacao.FIELDS.custo.label"}}</label>
        <div class="form-fields">
          {{#each simbolos}}
          <label class="asm-simbolo-campo" data-tooltip="{{rotulo}}">
            <img src="{{icone}}" alt="{{s}}">
            <input type="number" name="system.custo.{{s}}" value="{{custo}}" min="0" max="30" step="1" aria-label="{{rotulo}}">
          </label>
          {{/each}}
        </div>
        <p class="hint">{{localize "ASSIMILACAO.Ativacao.FIELDS.custo.hint"}}</p>
      </div>
      <div class="form-group asm-custo-simbolos">
        <label>{{localize "ASSIMILACAO.Ativacao.FIELDS.progresso.label"}}</label>
        <div class="form-fields">
          {{#each simbolos}}
          <label class="asm-simbolo-campo" data-tooltip="{{rotulo}}">
            <img src="{{icone}}" alt="{{s}}">
            <input type="number" name="system.progresso.{{s}}" value="{{progresso}}" min="0" max="{{custo}}" step="1" aria-label="{{rotulo}}">
          </label>
          {{/each}}
        </div>
      </div>
      {{formGroup systemFields.dano value=source.system.dano}}
      {{formGroup systemFields.alvos value=source.system.alvos}}
      {{formGroup systemFields.unicaVez value=source.system.unicaVez}}
      {{formGroup systemFields.pagamentoIntegral value=source.system.pagamentoIntegral}}
      {{formGroup systemFields.requerMunicao value=source.system.requerMunicao}}
      {{formGroup systemFields.disparos value=source.system.disparos}}
    {{/if}}
    {{#if ehObjetivo}}
      {{formGroup systemFields.categoria value=source.system.categoria localize=true}}
      {{formGroup systemFields.fuga value=source.system.fuga}}
      <fieldset class="asm-usos-campos">
        <legend>{{localize "ASSIMILACAO.Objetivo.FIELDS.custo.label"}}</legend>
        {{formGroup systemFields.custo.fields.base value=source.system.custo.base}}
        {{formGroup systemFields.custo.fields.porInfectadoExtra value=source.system.custo.porInfectadoExtra}}
        {{formGroup systemFields.custo.fields.porInfectado value=source.system.custo.porInfectado}}
        {{formGroup systemFields.custo.fields.minimoPorInfectado value=source.system.custo.minimoPorInfectado}}
        <p class="hint">{{custoResumo}}</p>
      </fieldset>
      {{formGroup systemFields.acumulo value=source.system.acumulo localize=true}}
      {{formGroup systemFields.repeticao value=source.system.repeticao localize=true}}
      <div class="form-group">
        <label>{{localize "ASSIMILACAO.Objetivo.FIELDS.ameaca.label"}}</label>
        <div class="form-fields"><select name="system.ameaca">{{selectOptions ameacasOpcoes selected=source.system.ameaca blank=nenhumaAmeaca}}</select></div>
        <p class="hint">{{localize "ASSIMILACAO.Objetivo.FIELDS.ameaca.hint"}}</p>
      </div>
      {{formGroup systemFields.restricao value=source.system.restricao}}
      {{formGroup systemFields.recompensa value=source.system.recompensa}}
    {{/if}}
    {{#if ehCondicionante}}
      {{formGroup systemFields.ativa value=source.system.ativa}}
      {{formGroup systemFields.termino value=source.system.termino}}
    {{/if}}
    {{#if systemFields.usos}}
    <fieldset class="asm-usos-campos">
      <legend>{{localize "ASSIMILACAO.Item.usos"}}</legend>
      {{formGroup systemFields.usos.fields.value value=source.system.usos.value}}
      {{formGroup systemFields.usos.fields.max value=source.system.usos.max}}
      {{formGroup systemFields.usos.fields.escopo value=source.system.usos.escopo localize=true}}
    </fieldset>
    {{/if}}
  </div>

  <div class="asm-bloco-rasgado">
    <h2 class="asm-faixa-pincel kraft">{{#if (or ehAtivacao ehCondicionante)}}{{localize "ASSIMILACAO.Ativacao.efeito"}}{{else}}{{localize "ASSIMILACAO.Item.descricao"}}{{/if}}</h2>
    <prose-mirror name="system.descricao" value="{{source.system.descricao}}" toggled
                  data-document-uuid="{{item.uuid}}">{{{descricaoHTML}}}</prose-mirror>
  </div>
</div>
