<header class="asm-cabecalho">
  <div class="asm-retrato-bloco">
    <div class="asm-marca" aria-hidden="true">
      <img src="systems/assimilacao/assets/ui/marca.svg" alt="">
    </div>
    <div class="asm-retrato">
      <img src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}" data-tooltip="{{localize "ASSIMILACAO.Ficha.retrato"}}">
      <ul class="asm-estados">
        {{#each estados}}<li class="asm-fita estado-{{id}}">{{localize rotulo}}</li>{{/each}}
      </ul>
    </div>
  </div>

  <div class="asm-campos-pautados">
    <label class="asm-campo nome">
      <span>{{localize "ASSIMILACAO.Ficha.nome"}}</span>
      <input type="text" name="name" value="{{actor.name}}" {{disabled (not editable)}}>
    </label>
    <div class="asm-subtitulo">{{localize "ASSIMILACAO.Origens.titulo"}}</div>
    <label class="asm-campo">
      <span>{{localize "ASSIMILACAO.Origens.eventoMarcante"}}</span>
      <input type="text" name="system.origens.eventoMarcante.texto" value="{{source.system.origens.eventoMarcante.texto}}">
      <input type="checkbox" name="system.origens.eventoMarcante.usado" {{checked source.system.origens.eventoMarcante.usado}}
             data-tooltip="{{localize "ASSIMILACAO.Origens.usadaDica"}}">
    </label>
    <label class="asm-campo">
      <span>{{localize "ASSIMILACAO.Origens.ocupacao"}}</span>
      <input type="text" name="system.origens.ocupacao.texto" value="{{source.system.origens.ocupacao.texto}}">
      <input type="checkbox" name="system.origens.ocupacao.usado" {{checked source.system.origens.ocupacao.usado}}
             data-tooltip="{{localize "ASSIMILACAO.Origens.usadaDica"}}">
    </label>
    <div class="asm-linha-dupla">
      <label class="asm-campo">
        <span>{{localize "ASSIMILACAO.Ficha.geracao"}}</span>
        <select name="system.geracao">{{selectOptions geracoes selected=source.system.geracao}}</select>
      </label>
      <label class="asm-campo curto">
        <span>{{localize "ASSIMILACAO.Ficha.idade"}}</span>
        <input type="number" name="system.idade" value="{{source.system.idade}}" min="0" step="1">
      </label>
      <label class="asm-campo">
        <span>{{localize "ASSIMILACAO.Ficha.conceito"}}</span>
        <input type="text" name="system.conceito" value="{{source.system.conceito}}" placeholder="{{localize "ASSIMILACAO.Ficha.conceitoDica"}}">
      </label>
    </div>
    <label class="asm-campo">
      <span>{{localize "ASSIMILACAO.Propositos.pessoais"}}</span>
      <input type="text" name="system.propositos.pessoal1" value="{{source.system.propositos.pessoal1}}">
    </label>
    <label class="asm-campo sem-rotulo">
      <span></span>
      <input type="text" name="system.propositos.pessoal2" value="{{source.system.propositos.pessoal2}}">
    </label>
    <label class="asm-campo">
      <span>{{localize "ASSIMILACAO.Propositos.coletivo"}}</span>
      <input type="text" name="system.propositos.coletivo" value="{{source.system.propositos.coletivo}}">
    </label>
  </div>
</header>
